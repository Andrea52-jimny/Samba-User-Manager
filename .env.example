# ---------------------------------------------------------------------------
# SMB User Manager - example configuration
#
# Copy this file to `.env` next to docker-compose.yml and edit the values.
# Every variable is optional: the defaults shown here are the ones compiled
# into the image. `.env` is git-ignored and never baked into the image.
#
#     cp .env.example .env
#
# ---------------------------------------------------------------------------

# --- Bootstrap administrator -----------------------------------------------
# Used ONLY on the very first start, when the SQLite database does not exist
# yet. Change the password from the web UI right after the first login;
# editing these values later has no effect on an existing database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# --- Storage ----------------------------------------------------------------
# Host path holding the real data. It is bind-mounted into the container at
# the same path, and must match the `path =` option of the share in smb.conf.
# The backing filesystem must support POSIX ACLs (see docs/ARCHITECTURE.md).
HOST_DATA_PATH=/mnt/dati
SMB_ROOT_PATH=/mnt/dati

# --- Samba ------------------------------------------------------------------
# Name of the share section in smb.conf that this app manages ([Dati] by
# default). If you rename the section, change this value as well.
SMB_SHARE_SECTION=Dati
SMB_CONF_PATH=/etc/samba/smb.conf
# System group every managed Samba user is added to.
SAMBA_GROUP=smbgroup

# --- Networking -------------------------------------------------------------
# Host port for the web UI. Change it if 8000 is already taken.
WEB_PORT=8000
# Host port for SMB. Leave 445 unless you know what you are doing.
SMB_PORT=445

# --- Sessions ---------------------------------------------------------------
SESSION_TTL_HOURS=12
# Set to true ONLY when the app is served over HTTPS through a reverse proxy.
SESSION_COOKIE_SECURE=false

# --- Behaviour --------------------------------------------------------------
# How often the background worker looks for expired accounts, in seconds.
EXPIRY_CHECK_INTERVAL_SECONDS=60

# --- Container ---------------------------------------------------------------
# Must match the timezone of the administrator: account expiry times are
# entered in the browser as local wall-clock time without an offset.
TZ=Europe/Rome
