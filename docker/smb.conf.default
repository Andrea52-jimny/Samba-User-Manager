# Default smb.conf used to seed /etc/samba/smb.conf on the first container
# start. Once seeded, this file is never touched again: edit the live copy in
# ./state/samba-etc/smb.conf, or use the web UI.
#
# The share below is named [Dati] ("Data" in Italian) for historical reasons.
# If you rename it, set SMB_SHARE_SECTION to the new name as well, otherwise
# the app will not find the section it is supposed to manage.

[global]
   log file = /var/log/samba/log.%m
   logging = file
   map to guest = Bad User
   max log size = 1000
   obey pam restrictions = Yes
   pam password change = Yes
   panic action = /usr/share/samba/panic-action %d
   passwd chat = *Enter\snew\s*\spassword:* %n\n *Retype\snew\s*\spassword:* %n\n *password\supdated\ssuccessfully* .
   passwd program = /usr/bin/passwd %u
   server role = standalone server
   unix password sync = Yes
   usershare allow guests = Yes
   idmap config * : backend = tdb

[Dati]
   comment = NAS storage
   create mask = 0660
   directory mask = 0770
   path = /mnt/dati
   read only = No
   valid users = @smbgroup
